# Doar nume, fara valori. Valorile reale stau in .env (ignorat de git)
# sau ca secrete in panoul Supabase / Vercel.

# Token personal Supabase, folosit doar local de CLI la migrari si deploy.
SUPABASE_ACCESS_TOKEN=

# Parola bazei de date, ceruta de CLI la legarea proiectului.
SUPABASE_DB_PASSWORD=
