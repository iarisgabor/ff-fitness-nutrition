<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Serviciul care ține apelul viu când ieși din aplicație. Fără el, Android oprește
             WebView-ul în câteva secunde de la trecerea în fundal, iar microfonul se închide.
             `microphone|mediaPlayback`: declarăm exact ce facem — de la Android 14, un serviciu
             de prim-plan care nu-și declară tipul corect e oprit forțat de sistem. -->
        <service
            android:name=".VoiceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- WhatsApp, prin notificări (vezi WhatsAppListener.java). Android pornește singur
             serviciul odată ce i se dă „Acces la notificări" din Setări — permisiunea nu poate
             fi cerută printr-un dialog, e prea sensibilă pentru asta. -->
        <service
            android:name=".WhatsAppListener"
            android:exported="true"
            android:label="Jarvis — mesaje"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- De la Android 11, o aplicație nu mai vede ce altele sunt instalate decât dacă le
         numește. Fără asta, intenția către WhatsApp (mesaj nou, pregătit) nu găsește nimic și
         s-ar deschide browserul în locul lui. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.spotify.music" />
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microfonul îi aparține acum APLICAȚIEI, nu browserului. Asta e diferența de fond față
         de varianta TWA: acolo captura rula în procesul Chrome, de-aia murea la ieșire. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Apeluri date prin voce („sună-l pe tata"). CALL_PHONE porneste apelul singur; fara ea se
         deschide doar tastatura cu numarul scris, si apesi tu. READ_CONTACTS e pentru cautarea
         numelui in agenda — cautarea se face PE TELEFON, agenda nu pleaca spre server. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notificarea persistentă a serviciului + notificările programate de asistent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ecranul de blocare: ca notificarea de apel să poată aprinde ecranul. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- „Afișare peste alte aplicații". Singurul lucru care ridică interdicția Android 10+ ca un
         serviciu din fundal să deschidă o activitate. Fără ea, „Jarvis" poate doar să pună o
         notificare pe care trebuie s-o apeși — cu ea, aplicația se deschide singură și intri
         direct în vorbă. Se acordă o singură dată, manual, din Setări. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Confirmarea tactilă la pornirea și închiderea unui apel (VoicePlugin.vibra). Permisiune
         normală: se acordă la instalare, fără dialog și fără cerere la rulare. -->
    <uses-permission android:name="android.permission.VIBRATE" />

</manifest>
